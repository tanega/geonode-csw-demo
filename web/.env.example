# GeoNode instance the frontend talks to directly (bypasses Traefik in local
# dev unless DOMAIN/hosts routing is set up — see root CLAUDE.md). Backend
# services (django, geoserver, etc.) run via `docker compose up`; only the
# frontend runs locally with `bun run dev` (http://localhost:5173).
#
# CORS is configured on the Django side, not here: the root .env's
# CORS_ALLOWED_ORIGINS already whitelists http://localhost:5173 (Vite's
# default port). If you run the dev server on a different port, or deploy
# this frontend to a new staging/prod origin, add that origin to root
# .env's CORS_ALLOWED_ORIGINS (comma-separated) — that's the only place
# it needs to be configured.
VITE_GEONODE_API_BASE=http://geonode.localhost

# django-oauth-toolkit public Application client_id, created by
# data/scripts/create_frontend_oauth_app.py (see docs/iam-option-a-login.md).
# Run the script against the running stack and copy its printed client_id.
VITE_OAUTH_CLIENT_ID=changeme
