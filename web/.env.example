# GeoNode instance the frontend talks to directly (bypasses Traefik in local
# dev unless DOMAIN/hosts routing is set up — see root CLAUDE.md).
VITE_GEONODE_API_BASE=http://geonode.localhost

# django-oauth-toolkit public Application client_id, created by
# data/scripts/create_frontend_oauth_app.py (see docs/iam-option-a-login.md).
# Run the script against the running stack and copy its printed client_id.
VITE_OAUTH_CLIENT_ID=changeme
