# Domain / routing
DOMAIN=geonode.localhost
SITEURL=http://geonode.localhost

# PostgreSQL/PostGIS — superuser (bootstrap only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# GeoNode app database
GEONODE_DATABASE=geonode
GEONODE_DATABASE_USER=geonode
GEONODE_DATABASE_PASSWORD=changeme

# GeoServer datastore database (vecteur)
GEONODE_GEODATABASE=geonode_data
GEONODE_GEODATABASE_USER=geonode_data
GEONODE_GEODATABASE_PASSWORD=changeme

# GeoNode admin (compte applicatif GeoNode, distinct de POSTGRES_USER)
GEONODE_ADMIN_USER=admin
GEONODE_ADMIN_PASSWORD=changeme
GEONODE_ADMIN_EMAIL=admin@geonode.localhost
GEONODE_SECRET_KEY=changeme

# GeoServer
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=changeme

# OAuth2 (fixture requise par le entrypoint GeoNode, "invoke prepare")
OAUTH2_CLIENT_ID=changeme
OAUTH2_CLIENT_SECRET=changeme
# JVM: valeurs réduites pour un usage dev/apprentissage (défaut upstream: 4G/4G)
GEOSERVER_JAVA_OPTS=-Djava.awt.headless=true -Xms512m -Xmx1G -Dgwc.context.suffix=gwc -Dfile.encoding=UTF8 -Duser.timezone=GMT -DGEOSERVER_CSRF_DISABLED=true -DALLOW_ENV_PARAMETRIZATION=true

# MinIO (object storage - GeoParquet/COG)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET=geonode-demo

# Traefik
TRAEFIK_DASHBOARD_PORT=8080
